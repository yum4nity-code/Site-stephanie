# Public site origin used to build callback/action links.
SITE_URL=https://example.com

# Optional Brevo transactional e-mail + newsletter integration.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Stéphanie Recorda
BREVO_NEWSLETTER_LIST_ID=

# Google Calendar integration for Stéphanie's own calendar.
# OAuth client must have Calendar write access for the account owning GOOGLE_CALENDAR_ID.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Legacy event color IDs used while the integration does not opt into Calendar labels.
# Defaults in code: 6 = pending/orange intent, 10 = handled/green intent.
GOOGLE_CALENDAR_PENDING_COLOR_ID=6
GOOGLE_CALENDAR_HANDLED_COLOR_ID=10

# Random server-side secret used to sign the "open / mark handled" link sent to Stéphanie.
# Use a long random value in production; never commit the real secret.
CALLBACK_STATUS_SECRET=
